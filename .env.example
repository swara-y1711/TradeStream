# Mock BSE base URL used by the main backend outside Docker Compose.
MOCK_BSE_URL=http://localhost:8001
# SQLite database location used by the main backend.
DB_PATH=./data/tradestream.db
# Maximum duration in seconds for one paginated Mock BSE request (below the 30s network limit).
PAGE_REQUEST_TIMEOUT=25
# Interval in seconds between WebSocket heartbeat messages.
WS_PING_SECONDS=20
# Browser origin allowed by the main backend CORS policy.
FRONTEND_ORIGIN=http://localhost:5173
# Public main-backend base URL used by the Vite frontend.
VITE_MAIN_BACKEND_URL=http://localhost:8000
# Network interface on which the Vite development server listens.
VITE_HOST=0.0.0.0
# Vite development server port and its Docker host mapping.
VITE_PORT=5173
# Main backend listener port and its Docker host mapping.
BACKEND_PORT=8000
# Network interface on which the main backend listens.
BACKEND_HOST=0.0.0.0
# Mock BSE listener port and its Docker host mapping.
MOCK_BSE_PORT=8001
# Network interface on which the Mock BSE service listens.
MOCK_BSE_HOST=0.0.0.0
# Target duration in seconds for a complete Mock BSE pull.
PULL_DELAY_SECONDS=900
# Number of deterministic Mock BSE trades generated at startup.
TOTAL_TRADES=5000
# Number of trades returned in each Mock BSE response page.
PAGE_SIZE=100
# Random seed used to generate deterministic Mock BSE trades.
SEED=42
